<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
    <Title>Subtitall</Title>
    <Authors>Purgator</Authors>
    <Product>Subtitall</Product>
    <Description>Find and download subtitles for your movies, TV shows and anime.</Description>
    <ElectronVersion>39.2.0</ElectronVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElectronNET.Core" Version="0.5.2" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.5.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Subtitall.Tests" />
  </ItemGroup>

  <!-- Built-in API keys, injected by CI (-p:OpenSubtitlesApiKey=… -p:TmdbApiKey=…).
       Empty in dev builds — the app then requires user-entered keys, as before. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuiltInOpenSubtitlesKey" Value="$(OpenSubtitlesApiKey)" />
    <AssemblyMetadata Include="BuiltInTmdbKey" Value="$(TmdbApiKey)" />
  </ItemGroup>

</Project>

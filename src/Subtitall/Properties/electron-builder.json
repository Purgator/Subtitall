{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/refs/heads/master/packages/app-builder-lib/scheme.json",
  "appId": "subtitall",
  "productName": "Subtitall",
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": "x64"
      }
    ],
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Subtitall-Setup-${version}.${ext}"
  },
  "linux": {
    "target": [
      "tar.xz"
    ],
    "executableArgs": [ "--no-sandbox" ],
    "artifactName": "${name}-${arch}-${version}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Purgator",
      "repo": "Subtitall"
    }
  ]
}
